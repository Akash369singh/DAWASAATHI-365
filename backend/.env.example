# Environment Configuration for CareCircle / DawaSaathi 365

# App Config
APP_NAME=CareCircle
ENVIRONMENT=development
DEBUG=true
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database (Default: local SQLite; replace with postgresql://... for Neon/Supabase/Render)
DATABASE_URL=sqlite:///./carecircle.db

# Security & JWT
SECRET_KEY=carecircle-super-secret-key-change-in-production-2026-hackathon
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Timezone (Default: Asia/Kolkata for IST)
TIMEZONE=Asia/Kolkata

# Google Gemini API Key for AI features (OCR, NL input, insights)
GEMINI_API_KEY=your_gemini_api_key_here

# Email / SMTP Configuration
# Set EMAIL_MODE=console to log email contents to terminal for development/testing
# Set EMAIL_MODE=smtp to send real emails via Gmail App Password or custom SMTP
EMAIL_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAIL_FROM=CareCircle Health <your_email@gmail.com>
